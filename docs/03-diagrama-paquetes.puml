@startuml
skinparam packageStyle rectangle

package "ecospot" {
  package "pages (UI)" {
    [auth_gate]
    [login_page / register_page]
    [home_page / search_page]
    [my_reservations_page]
    [payment_page]
    [admin_page]
  }
  package "services" {
    [auth_service]
    [accommodation_service]
    [reservation_service]
    [paypal_service]
    [qr_access_service]
  }
  package "models" {
    [accommodation]
    [qr_access_token]
  }
  package "data" {
    [mock_data]
  }
  package "theme" {
    [app_theme]
  }
}

package "Firebase" {
  [firebase_auth]
  [cloud_firestore]
}

package "PayPal SDK" {
  [paypal_js_sdk]
}

package "Hardware Fanvil" {
  [fanvil_door_api]
}

[pages (UI)] --> [services]
[pages (UI)] --> [theme]
[services] --> [models]
[auth_service] --> [firebase_auth]
[reservation_service] --> [cloud_firestore]
[accommodation_service] --> [cloud_firestore]
[paypal_service] --> [paypal_js_sdk]
[qr_access_service] --> [fanvil_door_api]
[qr_access_service] --> [reservation_service]
@enduml
